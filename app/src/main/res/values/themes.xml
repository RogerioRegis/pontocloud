<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.PontoCloud" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/primary_blue</item>
    </style>

    <style name="Theme.PontoCloud" parent="Base.Theme.PontoCloud" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/primary_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_ponto_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PontoCloud</item>
    </style>
</resources>
